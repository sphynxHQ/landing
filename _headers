# Cloudflare Pages headers — checked into the repo, applied on deploy.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'
  X-Robots-Tag: all

# the page itself must revalidate so copy edits go live immediately
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# fonts and images never change name, so they can be cached hard
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# the signup endpoint must never be cached
/subscribe
  Cache-Control: no-store
